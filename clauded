#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Ensure local host config directory exists for Claude's web SSO session
mkdir -p "$HOME/.claude"

# Check if --no-gh was passed as an argument
SKIP_GH=false
FORWARD_ARGS=()

for arg in "$@"; do
    if [ "$arg" = "--no-gh" ]; then
        SKIP_GH=true
    else
        FORWARD_ARGS+=("$arg")
    fi
done

# Generate readable, collision-free container naming
DIR_NAME=$(basename "$(pwd)")
DIR_HASH=$(echo -n "$(pwd)" | md5sum | cut -c 1-8)
CONTAINER_NAME="${DIR_NAME}-${DIR_HASH}-sandbox"

# Conditional GitHub CLI Authentication Check
ACTIVE_GH_TOKEN=""
if [ "$SKIP_GH" = false ]; then
    # Grab token; don't let a missing token trigger 'set -e' failure
    ACTIVE_GH_TOKEN=$(gh auth token 2>/dev/null || true)

    if [ -z "$ACTIVE_GH_TOKEN" ]; then
        echo "❌ Error: Your host machine is not logged into the GitHub CLI."
        echo "Please run 'gh auth login' on your host first, or use: claude-box --no-gh"
        exit 1
    fi
fi

# Boot the container if it's not already running
if ! docker ps -q -f name="^/${CONTAINER_NAME}$" > /dev/null; then
    if docker ps -aq -f name="^/${CONTAINER_NAME}$" > /dev/null; then
        docker rm "$CONTAINER_NAME" > /dev/null
    fi

    # Build our base docker run arguments array
    DOCKER_RUN_OPTS=(
        -d
        --name "$CONTAINER_NAME"
        --cap-drop=ALL
        --security-opt=no-new-privileges:true
        -v "$(pwd):/workspace:Z"
        -v "$HOME/.claude:/root/.claude:ro,Z"
        -v "$HOME/.gitconfig:/root/.gitconfig:ro,Z"
        --user "$(id -u):$(id -g)"
        -e HOME=/root
    )

    # Only inject the token if we didn't explicitly bypass it
    if [ "$SKIP_GH" = false ]; then
        DOCKER_RUN_OPTS+=(-e GH_TOKEN="$ACTIVE_GH_TOKEN")
    fi

    docker run "${DOCKER_RUN_OPTS[@]}" claude-sandbox:latest tail -f /dev/null > /dev/null
fi

# Execute inside the container transparently using filtered arguments
# Using exec here replaces the current script process entirely with the docker command
exec docker exec -it "$CONTAINER_NAME" claude "${FORWARD_ARGS[@]}"
