#!/usr/bin/env bash

# clauded — run Claude Code in an isolated Docker sandbox
# Usage: clauded [--no-gh] [--safe] [--rebuild] [--lockdown] [claude args...]
#
#   --no-gh     skip GitHub CLI auth injection
#   --safe      run Claude with normal permission prompts (default: auto-mode)
#   --rebuild   force a docker image rebuild before starting
#   --lockdown  route all container egress through an allowlist proxy;
#               the container gets no direct internet route (--internal network)
#
# Resource limits (overridable via env vars):
#   CLAUDED_PIDS_LIMIT  max processes/threads  (default: 4096)
#   CLAUDED_MEMORY      memory cap             (default: 8g)
#   CLAUDED_CPUS        CPU quota              (default: 4)
#
# Lockdown proxy (shared across all lockdown sandboxes):
#   Network:   claude-egress  (--internal Docker network)
#   Proxy:     claude-egress-proxy  (Squid, dual-homed)
#   Allowlist: egress-allowlist.conf  (in this repo, mounted into the proxy)

set -e

# ── Locate the repo directory even when invoked via a symlink on PATH ──────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# ── Parse our own flags; accumulate everything else for claude ─────────────────
SKIP_GH=false
SAFE_MODE=false
REBUILD=false
LOCKDOWN=false
FORWARD_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --no-gh)    SKIP_GH=true ;;
        --safe)     SAFE_MODE=true ;;
        --rebuild)  REBUILD=true ;;
        --lockdown) LOCKDOWN=true ;;
        *)          FORWARD_ARGS+=("$arg") ;;
    esac
done

# ── Build the image if it's missing or --rebuild was requested ─────────────────
if [ "$REBUILD" = true ] || ! docker image inspect claude-sandbox:latest > /dev/null 2>&1; then
    echo "🔨 Building claude-sandbox:latest …"
    docker build -f "$SCRIPT_DIR/Dockerfile.claude" -t claude-sandbox:latest "$SCRIPT_DIR"
fi

# ── Generate a readable, collision-free container name from the cwd ────────────
DIR_NAME=$(basename "$(pwd)")
DIR_HASH=$(echo -n "$(pwd)" | md5sum | cut -c 1-8)
CONTAINER_NAME="${DIR_NAME}-${DIR_HASH}-sandbox"

# ── On --rebuild, stop and remove any running container so the new image is used
if [ "$REBUILD" = true ]; then
    if [ -n "$(docker ps -q -f "name=^/${CONTAINER_NAME}$")" ]; then
        docker rm -f "$CONTAINER_NAME" > /dev/null
    fi
fi

# ── Conditional GitHub CLI authentication ─────────────────────────────────────
ACTIVE_GH_TOKEN=""
if [ "$SKIP_GH" = false ]; then
    ACTIVE_GH_TOKEN=$(gh auth token 2>/dev/null || true)
    if [ -z "$ACTIVE_GH_TOKEN" ]; then
        echo "❌  Error: not logged into the GitHub CLI on the host."
        echo "Run 'gh auth login' first, or skip with: clauded --no-gh"
        exit 1
    fi
fi

# ── Lockdown: ensure shared egress network + proxy are up ─────────────────────
# The proxy is dual-homed: it has access to the real internet AND the internal
# claude-egress network. Sandbox containers attach ONLY to claude-egress, which
# has no NAT route to the internet — so the proxy is the ONLY egress path.
# An agent that ignores the proxy env vars has nowhere to send packets.
if [ "$LOCKDOWN" = true ]; then
    EGRESS_NETWORK="claude-egress"
    EGRESS_PROXY="claude-egress-proxy"
    SQUID_IMAGE="ubuntu/squid:latest"

    # Create the internal network (no internet route) if it doesn't exist
    if ! docker network inspect "$EGRESS_NETWORK" > /dev/null 2>&1; then
        echo "🔒 Creating internal egress network: $EGRESS_NETWORK"
        docker network create --internal "$EGRESS_NETWORK" > /dev/null
    fi

    # Start the shared proxy if it's not running
    if ! docker ps -q -f "name=^/${EGRESS_PROXY}$" | grep -q .; then
        # Remove any stopped container with the same name
        if docker ps -aq -f "name=^/${EGRESS_PROXY}$" | grep -q .; then
            docker rm "$EGRESS_PROXY" > /dev/null
        fi
        echo "🔒 Starting egress proxy: $EGRESS_PROXY"
        docker run -d \
            --name "$EGRESS_PROXY" \
            --network "$EGRESS_NETWORK" \
            --cap-drop=ALL \
            --security-opt=no-new-privileges:true \
            --read-only \
            --tmpfs /var/log/squid:uid=13,gid=13 \
            --tmpfs /var/spool/squid:uid=13,gid=13 \
            --tmpfs /run:uid=13,gid=13 \
            -v "$SCRIPT_DIR/egress-allowlist.conf:/etc/squid/conf.d/allowlist.conf:ro" \
            "$SQUID_IMAGE" > /dev/null
        # Also attach the proxy to the default bridge so it can reach the internet
        docker network connect bridge "$EGRESS_PROXY" 2>/dev/null || true
    fi
fi

# ── Boot the container if it's not already running ────────────────────────────
if ! docker ps -q -f "name=^/${CONTAINER_NAME}$" > /dev/null 2>&1 || \
   [ -z "$(docker ps -q -f "name=^/${CONTAINER_NAME}$")" ]; then

    # Remove any stopped container with the same name
    if [ -n "$(docker ps -aq -f "name=^/${CONTAINER_NAME}$")" ]; then
        docker rm "$CONTAINER_NAME" > /dev/null
    fi

    # Build docker run options array
    DOCKER_RUN_OPTS=(
        -d
        --name "$CONTAINER_NAME"
        --cap-drop=ALL
        --security-opt=no-new-privileges:true
        # Read-only root FS — only the explicit mounts below are writable
        --read-only
        # Writable scratch space for compilers, npm, etc.
        --tmpfs /tmp:exec,mode=1777
        # Writable HOME (tmpfs, owned by the runtime uid) — dotfiles that
        # aren't explicitly mounted below land here ephemerally
        --tmpfs "/home/sandbox:exec,uid=$(id -u),gid=$(id -g),mode=0700"
        --user "$(id -u):$(id -g)"
        -e HOME=/home/sandbox
        # ── Resource limits ───────────────────────────────────────────────────
        # pids-limit: stops fork bombs; high enough for parallel gradlew builds
        # (Gradle daemon + workers + forked JVMs + threads all count as tasks).
        # Override with CLAUDED_PIDS_LIMIT, CLAUDED_MEMORY, CLAUDED_CPUS.
        --pids-limit="${CLAUDED_PIDS_LIMIT:-4096}"
        --memory="${CLAUDED_MEMORY:-8g}"
        # memory-swap == memory disables swap (prevents a leak from thrashing disk)
        --memory-swap="${CLAUDED_MEMORY:-8g}"
        --cpus="${CLAUDED_CPUS:-4}"
        # ── Mounts ────────────────────────────────────────────────────────────
        # Mount only the current repo — host home is invisible
        -v "$(pwd):/workspace:z"
        # Share the real ~/.claude dir read-write so Claude reuses the existing
        # login and persists sessions/history back to the host
        # NOTE: :z (shared SELinux relabel) keeps the host's own Claude functional
        -v "$HOME/.claude:/home/sandbox/.claude:z"
        # ~/.claude.json (main onboarding config, lives in $HOME not inside .claude/)
        -v "$HOME/.claude.json:/home/sandbox/.claude.json:z"
        # Git identity — read-only
        -v "$HOME/.gitconfig:/home/sandbox/.gitconfig:ro,z"
    )

    if [ "$SKIP_GH" = false ]; then
        DOCKER_RUN_OPTS+=(-e GH_TOKEN="$ACTIVE_GH_TOKEN")
    fi

    # ── Lockdown network: attach to internal network and point at proxy ────────
    # The container joins claude-egress (--internal, no NAT) and gets the proxy
    # in its env. No direct internet route exists — the proxy is the only path.
    if [ "$LOCKDOWN" = true ]; then
        DOCKER_RUN_OPTS+=(
            --network=claude-egress
            -e HTTPS_PROXY="http://claude-egress-proxy:3128"
            -e HTTP_PROXY="http://claude-egress-proxy:3128"
            -e NO_PROXY="localhost,127.0.0.1"
        )
    fi

    docker run "${DOCKER_RUN_OPTS[@]}" claude-sandbox:latest tail -f /dev/null > /dev/null
fi

# ── Ensure Claude's self-check symlink exists in the writable HOME tmpfs ────────
# Claude Code checks for itself at $HOME/.local/bin/claude on startup and warns
# if absent. HOME is a fresh tmpfs on every container boot, so we create the
# symlink here (idempotent; points at the fixed install path set in Dockerfile).
docker exec "$CONTAINER_NAME" \
    bash -c 'mkdir -p ~/.local/bin && ln -sf /usr/local/bin/claude ~/.local/bin/claude' \
    2>/dev/null || true

# ── Exec into the container ────────────────────────────────────────────────────
if [ "$SAFE_MODE" = true ]; then
    exec docker exec -it "$CONTAINER_NAME" claude "${FORWARD_ARGS[@]}"
else
    exec docker exec -it "$CONTAINER_NAME" claude --permission-mode auto "${FORWARD_ARGS[@]}"
fi
