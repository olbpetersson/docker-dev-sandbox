FROM fedora:44

# 1. Install system utilities, development tools, and GitHub CLI
RUN dnf update -y && dnf install -y \
    curl \
    git \
    jq \
    unzip \
    zip \
    procps-ng \
    which \
    openssh-clients \
    make \
    gcc \
    gcc-c++ \
    nodejs \
    npm \
    python3 \
    python3-pip \
    gh \
    && dnf clean all

# 2. Install Eclipse Temurin 25 (Java 25) via the official Adoptium RPM repo
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
        -o /etc/pki/rpm-gpg/RPM-GPG-KEY-adoptium \
    && printf '[Adoptium]\nname=Eclipse Temurin\nbaseurl=https://packages.adoptium.net/artifactory/rpm/fedora/$releasever/$basearch\nenabled=1\ngpgcheck=1\ngpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-adoptium\n' \
        > /etc/yum.repos.d/adoptium.repo \
    && dnf install -y temurin-25-jdk \
    && dnf clean all

# 3. Install Claude Code and TypeScript globally at a fixed, well-known path.
#    --prefix /usr/local guarantees the binary lands at /usr/local/bin/claude
#    regardless of how system npm is configured on this Fedora base.
RUN npm install -g --prefix /usr/local @anthropic-ai/claude-code typescript

# 4. Pre-create mount-point directories so they exist under a read-only rootfs.
#    /home/sandbox is the runtime HOME (tmpfs); /workspace is the default repo
#    mount; /work is used when --work-root mounts the full work tree.
RUN mkdir -p /home/sandbox /workspace /work && chmod 1777 /home/sandbox

WORKDIR /workspace
CMD ["tail", "-f", "/dev/null"]
